<%- include('partials/header') %>

    <form action="/new" method="post" class="message-form">
        <h2 class="form-heading">
            <span class="mdi mdi-pencil-outline" aria-hidden="true"></span>
            New message
        </h2>

        <%- include("partials/errors.ejs") %>

            <div class="form-group">
                <label for="messageUser" class="form-label">Name</label>
                <input type="text" name="messageUser" id="messageUser" required class="form-input"
                    placeholder="Who's writing?" value="<%= typeof messageUser !== 'undefined' ? messageUser : '' %>">
            </div>

            <div class="form-group">
                <label for="messageText" class="form-label">Message</label>
                <input type="text" name="messageText" id="messageText" required class="form-input"
                    placeholder="Say something sweet..."
                    value="<%= typeof messageText !== 'undefined' ? messageText : '' %>">
            </div>

            <div class="form-actions">
                <a href="./" class="cancel-link">Cancel</a>
                <button type="submit" class="submit-message-btn">
                    Send Message
                    <span class="mdi mdi-send-variant" aria-hidden="true"></span>
                </button>
            </div>
    </form>

    <%- include('partials/footer') %>