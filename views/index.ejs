<%- include('partials/header') %>

    <section class="hero">
        <h1 class="index-heading">Spread some positivity!</h1>
        <p class="index-subtitle">A cozy little corner for kind words</p>
        <a href="/new" class="add-message-link">
            <span class="mdi mdi-pencil-outline" aria-hidden="true"></span>
            Add a Message
        </a>
    </section>

    <% const tones=[ 'blush' , 'sage' , 'yale' ]; const tapeIcons=[ 'mdi-heart-outline' , 'mdi-flower-outline'
        , 'mdi-star-four-points-outline' ]; %>

        <% if (messages.length===0) { %>
            <div class="empty-state">
                <span class="mdi mdi-flower-outline empty-state__icon" aria-hidden="true"></span>
                <p class="empty-state__text">No messages yet. Be the first to say hello!</p>
            </div>
            <% } else { %>
                <ul class="messages-list">
                    <% messages.forEach((msg, index)=> {
                        const tone = tones[index % tones.length];
                        const tapeIcon = tapeIcons[index % tapeIcons.length];
                        %>
                        <li class="message-list-item message-list-item--<%= tone %>">
                            <span class="tape" aria-hidden="true">
                                <span class="mdi <%= tapeIcon %>"></span>
                            </span>

                            <div class="message-list-item__top">
                                <span class="message-user">
                                    <span class="mdi mdi-account-heart-outline" aria-hidden="true"></span>
                                    <%= msg.name %>
                                </span>

                                <span class="message-date">
                                    <span class="mdi mdi-clock-outline" aria-hidden="true"></span>
                                    <time class="js-local-date" datetime="<%= msg.created_at.toISOString() %>">
                                        <%= msg.created_at.toLocaleDateString() %> at <%=
                                                msg.created_at.toLocaleTimeString([], { hour: '2-digit' ,
                                                minute: '2-digit' }) %>
                                    </time>
                                </span>
                            </div>

                            <p class="message-text">
                                <%= msg.message %>
                            </p>

                            <a href="/message/<%= msg.id %>" class="message-link">
                                Open
                                <span class="mdi mdi-arrow-right" aria-hidden="true"></span>
                            </a>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <%- include('partials/footer') %>