<%- include('partials/header') %>

    <div class="error">
        <span class="error__icon mdi mdi-alert-circle-outline" aria-hidden="true"></span>
        <h1 class="error-heading">500 &mdash; Something Went Wrong</h1>
        <p class="error-text">Sorry, an unexpected error occurred on our end.</p>

        <% if (message) { %>
            <p class="error-message"><strong>Error:</strong>
                <%= message %>
            </p>
            <% } %>

                <a href="/" class="home-link">
                    <span class="mdi mdi-arrow-left" aria-hidden="true"></span>
                    Back to home
                </a>
    </div>

    <%- include('partials/footer') %>