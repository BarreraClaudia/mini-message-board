<%- include('partials/header') %>

    <h1>
        <%= message.user %>'s Message
    </h1>

    <p>
        <%= message.text %>
    </p>

    <p>
        Sent on <%= message.added.toLocaleDateString() %> at
            <%= message.added.toLocaleTimeString([], { hour: '2-digit' , minute: '2-digit' }) %>
    </p>

    <a href="/">Back to all messages</a>

    <%- include('partials/footer') %>